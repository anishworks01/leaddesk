# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/leaddesk
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leaddesk
MONGODB_URI=mongodb://127.0.0.1:27017/leaddesk

# Long random string used to sign the session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Port the server listens on. Render sets this automatically in production,
# this value is only used for local development.
PORT=3000

# Credentials for the seed script that creates the first admin account.
# Run `npm run seed:admin` once after setting these, then you can change the
# password from the .env file and re-run the seed script any time to reset it.
ADMIN_EMAIL=something
ADMIN_PASSWORD=change_this_password

# Set to "production" on Render so cookies are marked secure.
NODE_ENV=development
